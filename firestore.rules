rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Pets collection: public read, public create, update and delete
    match /pets/{petId} {
      allow read, write: if true;
    }

    // Alert and system logs
    match /alert_logs/{logId} {
      allow read: if true;
      allow write: if true;
    }

    // Suggestions collection
    match /suggestions/{sugId} {
      allow read: if true;
      allow write: if true;
    }

    // API Tokens collection for developers & MCP integrations
    match /api_tokens/{tokenId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
